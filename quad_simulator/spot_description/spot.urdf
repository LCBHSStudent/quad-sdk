<robot name="spot">
  <!-- Define materials -->
  <material name="gray">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="gold"> 
    <color rgba="1 0.8431 0 1"/></material>    
  <material name="darkgray">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.2 1.0"/>
  </material>
  <material name="scots-rose">
    <color rgba="0.937 0.2 0.251 1.0"/>
  </material>
  <!-- Robot Base Link -->
  <link name="body">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://spot_description/meshes/base_link_0_geom_visual_mesh.stl" scale="1 1 1" />
      </geometry>
      <material name="gold" />
    </visual>
    <inertial>
      <mass value="16.70765207"/>
      <inertia ixx="0.081543792" ixy="0.0" ixz="0.0" iyy="0.549231154" iyz="0.0" izz="0.569454373"/>
    </inertial>
    
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <box size="0.85 0.24 0.18"/>
      </geometry>
    </collision>
  </link>
  
  <gazebo reference="body">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <topic>__default_topic_</topic>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <topicName>imu</topicName>
        <bodyName>body</bodyName>
        <updateRateHZ>500.0</updateRateHZ>
        <gaussianNoise>0.0</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
        <frameName>body</frameName>
        <initialOrientationAsReference>true</initialOrientationAsReference>
      </plugin>
      <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo>

  <!-- Hip Links -->
  <link name="hip0">
    <visual>
      <origin rpy="0 0 0" xyz="0 0.0 0" />
      <geometry>
        <mesh filename="package://spot_description/meshes/fl_hip_0_geom_visual_mesh.stl"/>
      </geometry>
      <material name="gray" />
    </visual>
   
    <inertial>
      <inertia ixx="0.00122166" ixy="-0.00017754" ixz="0.00000043" iyy="0.00158957" iyz="-0.00000049" izz="0.00172903"/>
      <mass value="1.13688339"/>
    </inertial>
  </link>
  <gazebo reference="hip0">
    <material>Gazebo/Gray</material>
  </gazebo>

  <joint name="8" type="revolute">
    <parent link="body"/>
    <child link="hip0"/>
    <axis xyz="1 0 0"/>
    <origin xyz="0.29785 0.05500 0.00000"/>
    <limit effort="1000" velocity="1000.00" lower="-0.78539816339744827899" upper="0.78539816339744827899"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <transmission name="transmission_8">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="8">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor_8">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <link name="upper0">
  <origin rpy="0 0 0" xyz="0 0 0" />
    <visual>
      <geometry>
        <mesh filename="package://spot_description/meshes/l_uleg_0_geom_visual_mesh.stl"/>
